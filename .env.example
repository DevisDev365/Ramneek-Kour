# ========================================================
# Ramneek Bot Environment Configuration
# ========================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=devansh_bot_for_ramneek_bot

# 2. Exclusivity: Ramneek's Telegram identifiers
# Get your numeric user ID from @userinfobot on Telegram, or set your Telegram username (without @)
RAMNEEK_TELEGRAM_ID=
RAMNEEK_TELEGRAM_USERNAME=

# 3. Inception Labs API Configuration
INCEPTION_API_KEY=your_inception_api_key_here
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-3

# 4. Repository & Sync Protocol
GIT_REMOTE=origin
GIT_BRANCH=main
SYNC_REPO_ON_MESSAGE=true

# 5. Persona Prompt (Optional customization)
SYSTEM_PROMPT="You are Ramneek's dedicated, loving, intelligent, and highly supportive personal conversational companion. You speak exclusively with Ramneek. You are empathetic, attentive, witty, and always ready to help her with ideas, daily tasks, studies, reflections, and deep conversations. Keep responses warm, engaging, and clear."
